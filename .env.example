# =========================================================
# Konfigurasi Sistem Monitoring Stok dan Pemakaian Per Bagian
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# =========================================================

# Port server API (frontend dev berjalan di 5173)
PORT=3000

# Lingkungan: development | production
NODE_ENV=development

# Connection string PostgreSQL (Supabase). WAJIB diisi.
# Supabase -> Project Settings -> Database -> Connection string (URI, mode pooler 6543).
# Contoh:
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Untuk pengujian (npm test): connection string Postgres terpisah/schema uji.
# Isi schema uji pada query string bila memakai database yang sama, contoh:
# TEST_DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
TEST_DATABASE_URL=

# Set "require" bila koneksi Postgres membutuhkan SSL non-Supabase
DATABASE_SSL=

# Kunci acak untuk cookie/session. WAJIB diganti di produksi.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-64-karakter

# Masa berlaku sesi dalam jam
SESSION_TTL_HOURS=8

# URL aplikasi (untuk cookie Secure & dokumentasi)
APP_URL=http://localhost:5173

# Kredensial admin awal (hanya dipakai saat seed pertama kali)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrator Sistem
SEED_ADMIN_PASSWORD=Admin#12345

# Set true bila aplikasi sudah di belakang HTTPS
COOKIE_SECURE=false

# Batas ukuran file impor (byte), default 10 MB
MAX_UPLOAD_BYTES=10485760
